* filter=git-crypt diff=git-crypt

# GitHub must read the workflow before checkout can unlock the repository.
# These control surfaces contain no account data or secrets. The log sender
# must remain executable even when git-crypt unlock itself is the failed step.
.gitattributes !filter !diff
.github/workflows/*.yml !filter !diff
.github/workflows/*.yaml !filter !diff
.github/scripts/send_private_log.py !filter !diff
.github/scripts/prepare_git_crypt.sh !filter !diff
.github/dependabot.yml !filter !diff

# Vendored build inputs: the git-crypt binary must run before unlock, and the
# wheels hold only public PyPI packages. -text keeps them byte-exact.
.github/vendor/** !filter !diff -text

# Pinned public dependencies, deliberately plaintext so Dependabot can read them.
requirements.txt !filter !diff

# Public-facing surfaces: the root README and the screenshots it embeds must
# stay plaintext so GitHub can render them. Anchored so nested READMEs (e.g.
# data/reference/**) stay encrypted.
/README.md !filter !diff
docs/images/** !filter !diff

# Public, strategy-free bid-sync receipt compatibility contract and tests.
# These files contain anonymous fixtures and metadata-only schemas; they must
# remain reviewable on GitHub.
/docs/BID_SYNC_RECEIPTS.md !filter !diff
/src/bid_sync_receipts/** !filter !diff
/tests/test_bid_sync_receipts.py !filter !diff
/tests/fixtures/bid_sync_receipts/** !filter !diff
/tools/bid_sync_receipt_contract.py !filter !diff

# Public, strategy-free documentation consistency tests. This file reads only
# plaintext README/workflow version metadata and must remain reviewable on GitHub.
/tests/test_python_version_docs.py !filter !diff
